{
  "id": "/",
  "name": "Sourcebook 7",
  "short_name": "Sourcebook",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#222326",
  "theme_color": "#222326",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "audio/*",
            "video/*",
            "text/*",
            "application/pdf",
            "application/octet-stream",
            ".url",
            ".link",
            ".md",
            ".zip",
            ".dwg",
            ".3dm"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "application/pdf": [".pdf"],
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt", ".link"]
      }
    }
  ]
}
